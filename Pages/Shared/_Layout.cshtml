<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#fff8f0" />
    <meta name="description" content="Kutipan Gurun Sunyi — kumpulan renungan dan kata bijak dari hamparan pasir yang hening." />
    <title>@ViewData["Title"] — Kutipan Gurun Sunyi</title>
    <link rel="icon" href="~/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..600,0..1,0&display=swap" />

    <link rel="stylesheet" href="~/css/quote.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="q-body">
    @RenderBody()

    <script src="~/js/quote.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
