@page
@model ErrorModel
@{
    ViewData["Title"] = "Terjadi Kesalahan";
}

<div class="q-doc">
    <h1>@ViewData["Title"]</h1>
    <p>Maaf, ada sesuatu yang tidak berjalan sebagaimana mestinya.</p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
